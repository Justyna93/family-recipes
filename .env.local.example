# Claude AI — for recipe extraction (server-only, never exposed to browser)
ANTHROPIC_API_KEY=

# NextAuth — session signing secret (generate with: openssl rand -base64 32)
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# Users — JSON array of accounts (hash passwords with: npx tsx scripts/hash-password.ts <password>)
RECIPE_USERS=[{"email":"you@example.com","name":"Your Name","passwordHash":"$2b$12$..."}]

# Supabase — database (server-only)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Unsplash — auto-find recipe photos for screenshot imports (optional, server-only)
UNSPLASH_ACCESS_KEY=
